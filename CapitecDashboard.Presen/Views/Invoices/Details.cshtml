@model dynamic
@{
    ViewData["Title"] = "Invoice Details";
}

<h2>Invoice @Model?.data?.invoiceId</h2>
<dl class="row">
    <dt class="col-sm-3">Customer</dt>
    <dd class="col-sm-9">@Model?.data?.customerId</dd>
    <dt class="col-sm-3">Issue Date</dt>
    <dd class="col-sm-9">@Model?.data?.issueDate</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model?.data?.invoiceId" class="btn btn-primary">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back</a>


