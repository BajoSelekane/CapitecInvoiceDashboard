@model dynamic
@{
    ViewData["Title"] = "Invoices";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Invoices</h2>
    <a asp-action="Create" class="btn btn-primary">New Invoice</a>
    </div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Customer</th>
            <th>Created</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @if (Model?.data != null)
    {
        foreach (var row in Model.data)
        {
            <tr>
                <td>@row.invoiceId</td>
                <td>@row.customerId</td>
                <td>@row.issueDate</td>
                <td>
                    <a asp-action="Details" asp-route-id="@row.invoiceId" class="btn btn-sm btn-secondary">Details</a>
                    <a asp-action="Edit" asp-route-id="@row.invoiceId" class="btn btn-sm btn-warning">Edit</a>
                    <form asp-action="Delete" asp-route-id="@row.invoiceId" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    }
    </tbody>
</table>


