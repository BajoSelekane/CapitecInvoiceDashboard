@model dynamic
@{
    ViewData["Title"] = "Payments";
}

<h2>Payments</h2>
<a asp-controller="Invoices" asp-action="Details" asp-route-id="@ViewBag.InvoiceId">Back to Invoice</a>

<form asp-action="Create" method="post" class="row g-2 my-3">
    <input type="hidden" name="invoiceId" value="@ViewBag.InvoiceId" />
    <div class="col">
        <input name="amount" type="number" step="0.01" class="form-control" placeholder="Amount" />
    </div>
    <div class="col">
        <input name="method" class="form-control" placeholder="Method" />
    </div>
    <div class="col">
        <input name="reference" class="form-control" placeholder="Reference" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Add Payment</button>
    </div>
    </form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Amount</th>
            <th>Method</th>
            <th>Reference</th>
            <th>Paid At</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @if (Model != null)
    {
        foreach (var p in Model)
        {
            <tr>
                <td>@p.amount</td>
                <td>@p.method</td>
                <td>@p.reference</td>
                <td>@p.paidAt</td>
                <td>
                    <form asp-action="Delete" method="post" class="d-inline">
                        <input type="hidden" name="invoiceId" value="@ViewBag.InvoiceId" />
                        <input type="hidden" name="id" value="@p.id" />
                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    }
    </tbody>
</table>


