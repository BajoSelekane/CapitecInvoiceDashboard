@model dynamic
@{
    ViewData["Title"] = "Customers";
}

<h2>Customers</h2>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null)
        {
            foreach (var c in Model)
            {
                <tr>
                    <td>@c.customerName</td>
                    <td>@c.email</td>
                    <td>@c.phone</td>
                    <td>@c.status</td>
                    <td>
                        <form asp-action="UpdateStatus" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@c.id" />
                            <select name="status" class="form-select form-select-sm d-inline w-auto">
                                <option value="5" selected="@(c.status==5)">Active</option>
                                <option value="4" selected="@(c.status==4)">Deleted</option>
                                <option value="1" selected="@(c.status==1)">Pending</option>
                            </select>
                            <button type="submit" class="btn btn-sm btn-primary">Update</button>
                        </form>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>


